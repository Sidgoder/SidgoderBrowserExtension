{
  "manifest_version": 3,
  "name": "IPShow",
  "version": "0.1.0",
  "description": "Display current public IP address and regional information.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.ip.sb/*",
    "https://get.geojs.io/*",
    "https://ipapi.co/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "IPShow",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "24": "assets/icons/icon-24.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
